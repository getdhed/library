# Copy this file to .env and set real secrets/values

# --- Database ---
POSTGRES_DB=library
POSTGRES_USER=library
POSTGRES_PASSWORD=library
DATABASE_URL=postgres://library:library@db:5432/library?sslmode=disable

# --- Backend ---
# Generate a strong secret before first run (64+ chars)
JWT_SECRET=please_replace_with_strong_secret
CORS_ORIGINS=*

# Initial admin (used only on first boot to seed an account)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Администратор
SEED_ADMIN_PASSWORD=admin12345

# --- Frontend ---
# In docker, frontend proxies /api to backend service
BACKEND_PROXY_TARGET=http://backend:8080
VITE_API_URL=/api
# Keep empty to use same origin for files, or set to an absolute backend URL
VITE_BACKEND_URL=
