# Copy this file to .env and replace every value marked "replace".

# --- Database ---
POSTGRES_DB=library
POSTGRES_USER=library
# Fill both values before starting Compose. URL-encode the password in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=
# Host ports are bound to 127.0.0.1 by docker-compose.yml.
POSTGRES_HOST_PORT=5433

# --- Backend ---
# The process must listen on the container interface; host exposure stays loopback-only.
LISTEN_HOST=0.0.0.0
# Paste an independent random secret before first run (at least 32 chars).
# An empty value intentionally makes docker compose refuse to start.
JWT_SECRET=
# Public HTTPS origin configured in IIS; list several origins with commas.
CORS_ORIGINS=https://library.example.org
# Trust only immediate reverse proxies. The Docker bridge range is needed when
# IIS/front-end proxy traffic reaches the backend through Docker port forwarding.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
MAX_UPLOAD_SIZE_MB=50
MULTIPART_MEMORY_MB=8
BACKEND_HOST_PORT=8080

# Bootstrap superadmin. It is created only while no active superadmin and no
# persistent bootstrap marker exist. Change both fields locally before IIS is public.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Администратор
SEED_ADMIN_PASSWORD=admin12345

# --- Frontend ---
# IIS publishes this local port. The frontend proxies /api inside Docker.
FRONTEND_HOST_PORT=5173
BACKEND_PROXY_TARGET=http://backend:8080
